      "writtenOn": "2026-11-13T12:17:49Z",
      "side": 1,
      "message": "Fixed in PS2: the per-iteration except BadfishException keeps the loop polling instead of aborting the move on a transport error (verified).",
      "parentUuid": "d21d83d3_b6751076",
      "revId": "764c7dd747b484c4929d10890330ae801cd41f8e",
      "serverId": "d5d70762-12d0-45a1-890d-524b12d3f735"
    },
